from __future__ import annotations

import os
import csv
import numpy as np
from PIL import Image

from skimage.color import rgb2gray
from skimage.filters import threshold_otsu
from scipy.ndimage import (
    binary_fill_holes,
    binary_dilation as ndi_binary_dilation,
    binary_closing as ndi_binary_closing,
)
from skimage.morphology import disk
from skimage.measure import label, regionprops

from tiatoolbox.wsicore.wsireader import WSIReader


# -------------------------
# Thumbnail utilities
# -------------------------

def _thumb_to_rgb_uint8_np(x) -> np.ndarray:
    """
    Accepts PIL.Image or np.ndarray from tiatoolbox slide_thumbnail().
    Returns RGB uint8 ndarray (H,W,3).
    """
    if isinstance(x, Image.Image):
        if x.mode != "RGB":
            x = x.convert("RGB")
        return np.asarray(x, dtype=np.uint8)

    if isinstance(x, np.ndarray):
        arr = x
        if np.issubdtype(arr.dtype, np.floating):
            arr = np.clip(arr, 0.0, 1.0)
            arr = (arr * 255.0).round().astype(np.uint8)
        else:
            arr = arr.astype(np.uint8, copy=False)

        if arr.ndim == 2:
            arr = np.stack([arr, arr, arr], axis=-1)

        if arr.ndim == 3 and arr.shape[2] == 4:
            arr = arr[:, :, :3]
        elif arr.ndim == 3 and arr.shape[2] == 3:
            pass
        else:
            raise ValueError(f"Unexpected thumbnail shape: {arr.shape}")

        return arr

    raise TypeError(f"Unsupported thumbnail type: {type(x)}")


def get_thumbnail(reader: WSIReader, thumbnail_mpp: float) -> np.ndarray:
    """Thumbnail at chosen MPP. No extra clamping/coarsening."""
    thumb_obj = reader.slide_thumbnail(resolution=float(thumbnail_mpp), units="mpp")
    return _thumb_to_rgb_uint8_np(thumb_obj)


# -------------------------
# Tissue detection utilities
# -------------------------

def make_masks_for_components_and_final(rgb_img_np: np.ndarray, merge_radius_px: int = 12):
    """
    - component_mask: Otsu + fill holes + (optional) closing to bridge thin gaps.
    - final_mask    : Otsu + dilation (r=5, iter=1) + fill holes (for nice borders).
    """
    gray = rgb2gray(rgb_img_np).astype(np.float32)
    T = threshold_otsu(gray)
    base = gray < T  # True = tissue

    component_mask = binary_fill_holes(base)
    if merge_radius_px and merge_radius_px > 0:
        se_merge = disk(merge_radius_px).astype(bool)
        component_mask = ndi_binary_closing(component_mask, structure=se_merge, iterations=1)

    se_final = disk(5).astype(bool)
    dil = ndi_binary_dilation(base, structure=se_final, iterations=1)
    final_mask = binary_fill_holes(dil)

    return component_mask, final_mask


def letterbox_to_square(rgb_np: np.ndarray, mask_np: np.ndarray, target_size: int):
    """
    Simple aspect-ratio-preserving fit into target_size x target_size.
    Always scales so max(h,w) -> target_size (can upscale). No other clamping.
    """
    target_size = int(target_size)
    h, w = rgb_np.shape[:2]
    scale = target_size / max(h, w)
    new_w = max(1, int(round(w * scale)))
    new_h = max(1, int(round(h * scale)))

    rgb_resized = Image.fromarray(rgb_np).resize((new_w, new_h), resample=Image.BILINEAR)
    mask_resized = Image.fromarray((mask_np.astype(np.uint8) * 255)).resize(
        (new_w, new_h), resample=Image.NEAREST
    )

    canvas_rgb = np.ones((target_size, target_size, 3), dtype=np.uint8) * 255
    canvas_mask = np.zeros((target_size, target_size), dtype=np.uint8)

    y0 = (target_size - new_h) // 2
    x0 = (target_size - new_w) // 2
    canvas_rgb[y0:y0 + new_h, x0:x0 + new_w, :] = np.asarray(rgb_resized)
    canvas_mask[y0:y0 + new_h, x0:x0 + new_w] = np.asarray(mask_resized)

    return Image.fromarray(canvas_rgb), Image.fromarray(canvas_mask)


# -------------------------
# Core processing (thumbnail → components → split rule → letterbox)
# -------------------------

def process_wsi_thumbnail_to_square_multi(
    wsi_path: str,
    target_size: int = 512,          # <-- NEW: output size parameter

    thumbnail_mpp: float = 8.0,      # tunable thumbnail mpp
    pad: int = 20,
    min_area_ratio: float = 0.01,    # tunable small-fragment filter
    merge_radius_px: int = 20,       # tunable merge radius (thumbnail px)
    use_8_connectivity: bool = True,

    # keep this behavior from the earlier version:
    split_area_frac: float = 0.25,       # split only if >=2 comps each >= this fraction of kept tissue area
    density_single_thresh: float = 0.5,  # used only when NOT splitting by split_area_frac
    small_component_policy: str = "union",  # "union" or "largest" when NOT splitting
):
    """
    Same logic as before, but letterboxes to target_size x target_size.

    Returns: list of dicts with keys:
      - rgb: PIL.Image (target_size x target_size)
      - mask: PIL.Image (target_size x target_size)
      - bbox: (rmin, rmax, cmin, cmax) in thumbnail coords
      - area_px: component/union area
      - target_size: int
    """
    if small_component_policy not in ("union", "largest"):
        raise ValueError("small_component_policy must be 'union' or 'largest'")

    target_size = int(target_size)

    reader = WSIReader.open(wsi_path)
    thumb_rgb = get_thumbnail(reader, thumbnail_mpp=thumbnail_mpp)
    H, W = thumb_rgb.shape[:2]

    comp_mask, final_mask = make_masks_for_components_and_final(
        thumb_rgb, merge_radius_px=merge_radius_px
    )

    connectivity = 2 if use_8_connectivity else 1
    labeled = label(comp_mask, connectivity=connectivity)
    props = regionprops(labeled)

    # No tissue fallback
    if not props:
        crop_rgb = thumb_rgb
        crop_mask = final_mask
        rgb_out, mask_out = letterbox_to_square(crop_rgb, crop_mask, target_size=target_size)
        return [{
            "rgb": rgb_out,
            "mask": mask_out,
            "bbox": (0, H, 0, W),
            "area_px": 0,
            "target_size": target_size,
        }]

    # Filter tiny components
    total_area = int(comp_mask.sum())
    min_area = max(1, int(total_area * min_area_ratio))
    kept = [p for p in props if p.area >= min_area]
    if not kept:
        kept = [max(props, key=lambda p: p.area)]
    kept.sort(key=lambda p: p.area, reverse=True)

    sum_area = float(sum(p.area for p in kept))

    # Union bbox over kept
    rmin_all = min(p.bbox[0] for p in kept)
    cmin_all = min(p.bbox[1] for p in kept)
    rmax_all = max(p.bbox[2] for p in kept)
    cmax_all = max(p.bbox[3] for p in kept)

    union_h = rmax_all - rmin_all
    union_w = cmax_all - cmin_all
    union_area = max(1, union_h * union_w)
    density = sum_area / union_area

    # Big-components rule (keep as before)
    area_fracs = [p.area / sum_area for p in kept]
    big_idxs = [i for i, f in enumerate(area_fracs) if f >= split_area_frac]

    size_tag = f"{target_size}x{target_size}"

    # If >=2 big components -> split into those big components only
    if len(big_idxs) >= 2:
        outputs = []
        for i in big_idxs:
            p = kept[i]
            r0, c0, r1, c1 = p.bbox
            rmin = max(0, r0 - pad)
            rmax = min(H, r1 + pad)
            cmin = max(0, c0 - pad)
            cmax = min(W, c1 + pad)

            crop_rgb = thumb_rgb[rmin:rmax, cmin:cmax, :]
            crop_mask = final_mask[rmin:rmax, cmin:cmax]

            rgb_out, mask_out = letterbox_to_square(crop_rgb, crop_mask, target_size=target_size)
            outputs.append({
                "rgb": rgb_out,
                "mask": mask_out,
                "bbox": (rmin, rmax, cmin, cmax),
                "area_px": int(p.area),
                "target_size": target_size,
                "size_tag": size_tag,
            })
        return outputs

    # Otherwise: DO NOT split (policy/density decide union vs largest)
    if small_component_policy == "largest" and density < density_single_thresh:
        p = kept[0]
        r0, c0, r1, c1 = p.bbox
        rmin = max(0, r0 - pad)
        rmax = min(H, r1 + pad)
        cmin = max(0, c0 - pad)
        cmax = min(W, c1 + pad)

        crop_rgb = thumb_rgb[rmin:rmax, cmin:cmax, :]
        crop_mask = final_mask[rmin:rmax, cmin:cmax]

        rgb_out, mask_out = letterbox_to_square(crop_rgb, crop_mask, target_size=target_size)
        return [{
            "rgb": rgb_out,
            "mask": mask_out,
            "bbox": (rmin, rmax, cmin, cmax),
            "area_px": int(p.area),
            "target_size": target_size,
            "size_tag": size_tag,
        }]

    # Default: union crop
    rmin = max(0, rmin_all - pad)
    rmax = min(H, rmax_all + pad)
    cmin = max(0, cmin_all - pad)
    cmax = min(W, cmax_all + pad)

    crop_rgb = thumb_rgb[rmin:rmax, cmin:cmax, :]
    crop_mask = final_mask[rmin:rmax, cmin:cmax]

    rgb_out, mask_out = letterbox_to_square(crop_rgb, crop_mask, target_size=target_size)
    return [{
        "rgb": rgb_out,
        "mask": mask_out,
        "bbox": (rmin, rmax, cmin, cmax),
        "area_px": int(sum_area),
        "target_size": target_size,
        "size_tag": size_tag,
    }]


# -------------------------
# CSV runner (keeps folder structure)
# -------------------------

def read_paths_from_csv(csv_path: str, col: str = "path"):
    paths = []
    with open(csv_path, "r", newline="") as f:
        reader = csv.DictReader(f)
        if col not in (reader.fieldnames or []):
            raise ValueError(f"CSV must contain column '{col}'. Found: {reader.fieldnames}")
        for row in reader:
            p = (row[col] or "").strip()
            if p:
                paths.append(p)
    return paths


def ensure_dir(p: str):
    os.makedirs(p, exist_ok=True)


def process_from_csv(
    csv_path: str,
    output_root_img: str,
    output_root_mask: str,
    input_root_for_structure: str | None = None,
    **process_kwargs,
):
    """
    Note: set target_size via process_kwargs (e.g., target_size=768).
    Filenames will include '{target_size}x{target_size}' automatically.
    """
    ensure_dir(output_root_img)
    ensure_dir(output_root_mask)

    wsi_paths = read_paths_from_csv(csv_path, col="path")
    if input_root_for_structure is None and wsi_paths:
        input_root_for_structure = os.path.commonpath(wsi_paths)

    # Determine tag once (if provided)
    target_size = int(process_kwargs.get("target_size", 512))
    size_tag = f"{target_size}x{target_size}"

    for wsi_path in wsi_paths:
        if not os.path.exists(wsi_path):
            print(f"Skipping missing: {wsi_path}")
            continue

        slide_name = os.path.splitext(os.path.basename(wsi_path))[0]

        if input_root_for_structure:
            rel = os.path.relpath(wsi_path, start=input_root_for_structure)
            rel_dir = os.path.dirname(rel)
            out_dir_img = os.path.join(output_root_img, rel_dir)
            out_dir_mask = os.path.join(output_root_mask, rel_dir)
        else:
            out_dir_img = output_root_img
            out_dir_mask = output_root_mask

        ensure_dir(out_dir_img)
        ensure_dir(out_dir_mask)

        print(f"Processing: {wsi_path}")
        try:
            parts = process_wsi_thumbnail_to_square_multi(wsi_path, **process_kwargs)
        except Exception as e:
            print(f"  ERROR: {e}")
            continue

        if len(parts) == 1:
            rgb_path = os.path.join(out_dir_img, f"{slide_name}_{size_tag}.png")
            mask_path = os.path.join(out_dir_mask, f"{slide_name}_{size_tag}_mask.png")
            parts[0]["rgb"].save(rgb_path)
            parts[0]["mask"].save(mask_path)
            print(f"  Saved {rgb_path}")
            print(f"  Saved {mask_path}")
        else:
            for i, it in enumerate(parts, start=1):
                suffix = f"_part{i:02d}_{size_tag}"
                rgb_path = os.path.join(out_dir_img, f"{slide_name}{suffix}.png")
                mask_path = os.path.join(out_dir_mask, f"{slide_name}{suffix}_mask.png")
                it["rgb"].save(rgb_path)
                it["mask"].save(mask_path)
                print(f"  Saved {rgb_path} (area={it['area_px']})")
                print(f"  Saved {mask_path}")

        print("  Done.")


